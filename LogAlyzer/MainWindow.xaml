
    
    
    <Window x:Class="LogAlyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrls="clr-namespace:LogAlyzer.Controls"
        xmlns:views="clr-namespace:LogAlyzer.Views"
        mc:Ignorable="d"
        Title="LogAlyzer" Height="450" Width="800" Icon="/Resources/Icons/LogAlyzer.png"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <DataTemplate x:Key="LogListTemplate">
            <views:LogListView />
        </DataTemplate>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="ToggleButton.Checked" SourceName="SettingsToggle">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SettingsPaneTransform"
                                     Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="ToggleButton.Unchecked" SourceName="SettingsToggle">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SettingsPaneTransform"
                                     Storyboard.TargetProperty="X"
                                     To="420" Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="160" />
                <ColumnDefinition Width="*" MinWidth="80" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding AddListCommand}" BorderThickness="0" Background="{x:Null}">
                <Image Source="/Resources/Icons/Add_log-view.ico" Width="20" Height="20" />
            </Button>

            <ctrls:DateRangePicker Grid.Column="1"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Stretch"
                                   MinWidth="160"
                                   FromDate="{Binding FilterFromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   ToDate="{Binding FilterToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox Grid.Column="2"
                     Margin="12,0,0,0"
                     MinWidth="80"
                     HorizontalAlignment="Stretch"
                     Style="{StaticResource WatermarkTextBoxStyle}"
                     ctrls:WatermarkService.Placeholder="Suche in allen Logs"
                     Text="{Binding GlobalSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="3" Margin="6,0,0,0" Command="{Binding RunSearchCommand}">
                <TextBlock Text="Suchen" />
            </Button>

            <ToggleButton Grid.Column="4"
                          Margin="12,0,0,0"
                          Width="50"
                          Padding="10,2"
                          VerticalAlignment="Center"
                          IsChecked="{Binding SettingsVM.SyncSelectionAcrossLists, Mode=TwoWay}"
                          Content="Sync">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="Background" Value="#FFE6E6E6" />
                        <Setter Property="BorderBrush" Value="#FFBFBFBF" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FF9B0000" />
                                <Setter Property="Background" Value="#FFD62828" />
                                <Setter Property="BorderBrush" Value="#FF9B0000" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFD62828" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <ToggleButton Grid.Column="5" x:Name="SettingsToggle" Margin="12,0,0,0" IsChecked="{Binding IsSettingsPaneOpen, Mode=TwoWay}">
                <Image Source="/Resources/Icons/Settings.ico" Width="20" Height="20" />
            </ToggleButton>
        </Grid>
        <Grid x:Name="LogListsHost" Grid.Row="2" />

        <!-- Sliding Settings Pane -->
        <Border x:Name="SettingsPane" Grid.RowSpan="3" Width="320" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1" HorizontalAlignment="Right" DataContext="{Binding SettingsVM}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsPaneTransform" X="420" />
            </Border.RenderTransform>
            <views:SettingsView />
        </Border>
    </Grid>
</Window>
